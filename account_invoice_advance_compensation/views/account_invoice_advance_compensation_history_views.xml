<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="account_invoice_advance_compensation_history_view_list"
        model="ir.ui.view"
    >
        <field name="name">account.invoice.advance.compensation.history.list</field>
        <field name="model">account.invoice.advance.compensation.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date" />
                <field name="move_id" />
                <field name="invoice_line_id" />
                <field name="advance_line_id" />
                <field name="compensation_move_id" />
                <field name="journal_id" />
                <field name="amount" widget="monetary" />
                <field name="currency_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record
        id="account_invoice_advance_compensation_history_action"
        model="ir.actions.act_window"
    >
        <field name="name">Advance Compensations</field>
        <field name="res_model">account.invoice.advance.compensation.history</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
